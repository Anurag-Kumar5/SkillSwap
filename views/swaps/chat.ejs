<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Chat — SkillSwap</title>
  <meta name="description" content="Real-time chat and video calling for your skill swap session.">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/design-system.css">
  <link rel="stylesheet" href="/css/components.css">
  <link rel="stylesheet" href="/css/layout.css">
  <link rel="stylesheet" href="/css/responsive.css">
  <script>
    (function(){
      const t = localStorage.getItem('theme') || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      document.documentElement.setAttribute('data-theme', t);
    })();
  </script>
  <script src="/socket.io/socket.io.js"></script>
</head>
<body style="overflow: hidden;">
  <% const partner = (swap.requester._id.toString() === user._id.toString()) ? swap.recipient : swap.requester; %>

  <!-- Navbar (minimal for chat) -->
  <%- include('../partials/header') %>

  <!-- Full chat layout -->
  <div style="display: flex; height: calc(100vh - var(--nav-height)); background: var(--color-bg);">

    <!-- ── Left Sidebar: Chat Info ── -->
    <div style="width: 260px; border-right: 1px solid var(--color-border); background: var(--color-bg-subtle); display: flex; flex-direction: column; flex-shrink: 0;" class="d-none d-lg-flex">
      <!-- Back + title -->
      <div style="padding: var(--space-4); border-bottom: 1px solid var(--color-border);">
        <a href="/swaps" style="display: inline-flex; align-items: center; gap: var(--space-2); font-size: var(--text-sm); color: var(--color-text-secondary); text-decoration: none; margin-bottom: var(--space-4);">
          <i class="bi bi-arrow-left"></i> All Swaps
        </a>
        <div style="display: flex; align-items: center; gap: var(--space-3);">
          <img src="<%= partner.avatar || 'https://ui-avatars.com/api/?name=' + encodeURIComponent(partner.name) + '&background=2563EB&color=fff&size=64' %>"
               class="avatar avatar-lg"
               alt="<%= partner.name %>"
               onerror="this.src='https://ui-avatars.com/api/?name=<%= encodeURIComponent(partner.name) %>&background=2563EB&color=fff&size=64'">
          <div>
            <div style="font-size: var(--text-sm); font-weight: var(--weight-semibold); color: var(--color-text);"><%= partner.name %></div>
            <div style="font-size: var(--text-xs); color: var(--color-text-muted);">Swap partner</div>
          </div>
        </div>
      </div>
      <!-- Swap details -->
      <div style="padding: var(--space-4); flex: 1;">
        <div style="font-size: var(--text-xs); font-weight: var(--weight-semibold); color: var(--color-text-muted); text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: var(--space-3);">Skill Exchange</div>
        <div style="display: flex; flex-direction: column; gap: var(--space-3);">
          <div>
            <div style="font-size: 10px; color: var(--color-text-muted); margin-bottom: 4px;">TOPIC</div>
            <span class="skill-chip"><%= swap.skillRequested.name %></span>
          </div>
        </div>
      </div>
    </div>

    <!-- ── Main Chat Area ── -->
    <div style="flex: 1; display: flex; flex-direction: column; min-width: 0;">
      <!-- Chat Header (mobile back button + partner name) -->
      <div style="padding: var(--space-3) var(--space-4); border-bottom: 1px solid var(--color-border); background: var(--color-bg); display: flex; align-items: center; gap: var(--space-3);">
        <a href="/swaps" class="btn btn-ghost btn-icon d-lg-none">
          <i class="bi bi-arrow-left"></i>
        </a>
        <img src="<%= partner.avatar || 'https://ui-avatars.com/api/?name=' + encodeURIComponent(partner.name) + '&background=2563EB&color=fff&size=64' %>"
             class="avatar avatar-sm"
             alt="<%= partner.name %>"
             onerror="this.src='https://ui-avatars.com/api/?name=<%= encodeURIComponent(partner.name) %>&background=2563EB&color=fff&size=64'">
        <div>
          <div style="font-size: var(--text-sm); font-weight: var(--weight-semibold); color: var(--color-text);"><%= partner.name %></div>
          <div style="font-size: var(--text-xs); color: var(--color-text-muted);">About: <%= swap.skillRequested.name %></div>
        </div>
        <div style="margin-left: auto; display: flex; gap: var(--space-2);">
          <button id="startCallBtn" class="btn btn-outline-secondary btn-sm" title="Start video call">
            <i class="bi bi-camera-video-fill me-1"></i><span class="d-none d-sm-inline">Start Call</span>
          </button>
          <button id="acceptCallBtn" class="btn btn-success btn-sm" style="display:none;" title="Accept incoming call">
            <i class="bi bi-telephone-inbound-fill me-1"></i>Accept
          </button>
        </div>
      </div>

      <!-- Video Area (hidden by default, preserved exactly) -->
      <div id="videoArea" style="display:none; background: #0F172A; padding: var(--space-4); gap: var(--space-3);">
        <div style="display: flex; gap: var(--space-3); height: 220px;">
          <div style="flex: 1; position: relative; border-radius: var(--radius-lg); overflow: hidden; background: #1E293B;">
            <video id="remoteVideo" style="width: 100%; height: 100%; object-fit: cover;" autoplay playsinline></video>
            <div style="position: absolute; top: var(--space-2); left: var(--space-2); background: rgba(0,0,0,0.5); color: white; font-size: 11px; padding: 2px 8px; border-radius: var(--radius-sm); backdrop-filter: blur(4px);"><%= partner.name %></div>
          </div>
          <div style="width: 160px; position: relative; border-radius: var(--radius-lg); overflow: hidden; background: #1E293B; flex-shrink: 0;">
            <video id="localVideo" style="width: 100%; height: 100%; object-fit: cover;" autoplay muted playsinline></video>
            <div style="position: absolute; top: var(--space-2); left: var(--space-2); background: rgba(0,0,0,0.5); color: white; font-size: 11px; padding: 2px 8px; border-radius: var(--radius-sm); backdrop-filter: blur(4px);">You</div>
          </div>
        </div>
        <div style="display: flex; justify-content: center; padding-top: var(--space-2);">
          <button id="endCallBtn" class="btn btn-danger btn-sm">
            <i class="bi bi-telephone-x-fill me-1"></i>End Call
          </button>
        </div>
      </div>

      <!-- Messages -->
      <div id="messages" style="flex: 1; overflow-y: auto; padding: var(--space-5); display: flex; flex-direction: column; gap: var(--space-3); min-height: 0;">
        <!-- Messages render here via JS -->
      </div>

      <!-- Compose Area -->
      <div style="border-top: 1px solid var(--color-border); padding: var(--space-3) var(--space-4); background: var(--color-bg);">
        <!-- Quick actions row -->
        <div style="display: flex; gap: var(--space-2); margin-bottom: var(--space-2);">
          <button id="recordBtn" class="btn btn-outline-secondary btn-sm" title="Record audio">
            <i class="bi bi-mic-fill me-1"></i><span class="d-none d-sm-inline">Audio</span>
          </button>
          <label class="btn btn-outline-secondary btn-sm mb-0" title="Attach file" style="cursor: pointer;">
            <i class="bi bi-paperclip me-1"></i><span class="d-none d-sm-inline">File</span>
            <input id="fileInput" type="file" style="display: none;">
          </label>
        </div>
        <!-- Message input -->
        <form id="chatForm" style="display: flex; gap: var(--space-2);">
          <input type="text" id="chatInput" class="form-control"
                 placeholder="Type a message..." required
                 style="flex: 1; border-radius: var(--radius-full);">
          <button class="btn btn-primary" type="submit" style="border-radius: var(--radius-full); width: 44px; height: 44px; padding: 0; flex-shrink: 0;">
            <i class="bi bi-send-fill" style="font-size: 0.875rem;"></i>
          </button>
        </form>
      </div>
    </div>
  </div>

  <!-- Toast Container -->
  <div id="toastContainer" aria-live="polite"></div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/main.js"></script>
  <script>
    // ── All original chat + WebRTC logic preserved exactly ─
    const userId = '<%= user._id %>';
    const swapId = '<%= swap._id %>';
    const otherUserId = '<%= (swap.requester._id.toString() === user._id.toString()) ? swap.recipient._id : swap.requester._id %>';
    const socket = io();
    if (userId) socket.emit('joinRoom', userId);

    const list = document.getElementById('messages');
    function render(msg) {
      const div = document.createElement('div');
      const mine = (msg.sender && msg.sender._id ? msg.sender._id : msg.sender) === userId;
      div.className = 'message ' + (mine ? 'me' : 'other');
      const senderName = mine ? 'You' : (msg.sender?.name || 'Partner');
      const timeStr = new Date(msg.createdAt || Date.now()).toLocaleTimeString([], {hour:'2-digit',minute:'2-digit'});
      let body = '';
      if (msg.type === 'audio' && msg.audioUrl) {
        body = `<audio controls src="${msg.audioUrl}" style="max-width: 240px; border-radius: var(--radius-base);"></audio>`;
      } else if (msg.type === 'file' && msg.fileUrl) {
        body = `<a href="${msg.fileUrl}" target="_blank" rel="noopener" style="color: inherit; text-decoration: underline;">📎 ${msg.fileName || 'Attachment'}</a>`;
      } else {
        body = `<div class="message-bubble">${msg.text || ''}</div>`;
      }
      div.innerHTML = body + `<div class="message-time">${senderName} · ${timeStr}</div>`;
      list.appendChild(div);
      list.scrollTop = list.scrollHeight;
    }

    fetch(`/api/chats/${swapId}`).then(r => r.json()).then(msgs => msgs.forEach(render));
    socket.on('newMessage', (data) => { if (data.swapId === swapId) render(data.message); });

    document.getElementById('chatForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      const input = document.getElementById('chatInput');
      const text = input.value.trim();
      if (!text) return;
      const res = await fetch('/api/chats', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({ swapId, recipientId: otherUserId, text })
      });
      if (res.ok) { render(await res.json()); input.value = ''; }
    });

    // ── Audio Recording ────────────────────────────────────
    const recordBtn = document.getElementById('recordBtn');
    let mediaRecorder = null, recordedChunks = [], recordingStream = null;

    async function uploadBlobAndSend(blob, filename) {
      const fd = new FormData();
      fd.append('file', blob, filename);
      const up = await fetch('/api/upload', { method: 'POST', body: fd });
      if (!up.ok) throw new Error('Upload failed');
      const data = await up.json();
      const res = await fetch('/api/chats', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({ swapId, recipientId: otherUserId, type: 'audio', audioUrl: data.url })
      });
      if (res.ok) render(await res.json());
    }

    recordBtn.addEventListener('click', async () => {
      if (!mediaRecorder) {
        try {
          recordingStream = await navigator.mediaDevices.getUserMedia({ audio: true });
          mediaRecorder = new MediaRecorder(recordingStream, { mimeType: 'audio/webm' });
          recordedChunks = [];
          mediaRecorder.ondataavailable = e => { if (e.data && e.data.size) recordedChunks.push(e.data); };
          mediaRecorder.onstop = async () => {
            try { await uploadBlobAndSend(new Blob(recordedChunks, { type: 'audio/webm' }), `audio-${Date.now()}.webm`); } catch {}
            recordedChunks = []; mediaRecorder = null;
            recordBtn.style.borderColor = ''; recordBtn.style.color = '';
            recordBtn.innerHTML = '<i class="bi bi-mic-fill me-1"></i><span class="d-none d-sm-inline">Audio</span>';
            if (recordingStream) { recordingStream.getTracks().forEach(t => t.stop()); recordingStream = null; }
          };
          mediaRecorder.start();
          recordBtn.style.borderColor = 'var(--color-danger)'; recordBtn.style.color = 'var(--color-danger)';
          recordBtn.innerHTML = '<i class="bi bi-stop-fill me-1"></i>Stop';
        } catch { alert('Microphone access denied.'); }
      } else { mediaRecorder.stop(); }
    });

    // ── File Upload ────────────────────────────────────────
    document.getElementById('fileInput').addEventListener('change', async (e) => {
      const file = e.target.files?.[0];
      if (!file) return;
      const fd = new FormData(); fd.append('file', file);
      try {
        const up = await fetch('/api/upload', { method: 'POST', body: fd });
        if (!up.ok) throw new Error('Upload failed');
        const data = await up.json();
        const res = await fetch('/api/chats', {
          method: 'POST', headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify({ swapId, recipientId: otherUserId, type: 'file', fileUrl: data.url, fileName: file.name, mimeType: file.type })
        });
        if (res.ok) render(await res.json());
      } catch { alert('Upload failed.'); } finally { e.target.value = ''; }
    });

    // ── WebRTC (all preserved) ─────────────────────────────
    const startCallBtn = document.getElementById('startCallBtn');
    const acceptCallBtn = document.getElementById('acceptCallBtn');
    const endCallBtn = document.getElementById('endCallBtn');
    const localVideo = document.getElementById('localVideo');
    const remoteVideo = document.getElementById('remoteVideo');
    const videoArea = document.getElementById('videoArea');
    let peerConnection = null, localStream = null, hasIncomingOffer = null;
    const rtcConfig = { iceServers: [{ urls: 'stun:stun.l.google.com:19302' }] };

    async function ensureLocalStream() {
      if (!localStream) { localStream = await navigator.mediaDevices.getUserMedia({ video: true, audio: true }); localVideo.srcObject = localStream; }
    }
    function createPeer() {
      peerConnection = new RTCPeerConnection(rtcConfig);
      peerConnection.onicecandidate = (e) => { if (e.candidate) socket.emit('webrtc-ice', { to: otherUserId, from: userId, swapId, candidate: e.candidate }); };
      peerConnection.ontrack = (e) => { remoteVideo.srcObject = e.streams[0]; };
      if (localStream) localStream.getTracks().forEach(t => peerConnection.addTrack(t, localStream));
    }
    function showVideoArea(show) { videoArea.style.display = show ? '' : 'none'; }
    async function startCall() {
      try { await ensureLocalStream(); createPeer(); const offer = await peerConnection.createOffer(); await peerConnection.setLocalDescription(offer); showVideoArea(true); socket.emit('webrtc-offer', { to: otherUserId, from: userId, swapId, sdp: offer }); } catch { alert('Could not start call.'); }
    }
    async function acceptCall() {
      if (!hasIncomingOffer) return;
      try { await ensureLocalStream(); createPeer(); await peerConnection.setRemoteDescription(new RTCSessionDescription(hasIncomingOffer.sdp)); const answer = await peerConnection.createAnswer(); await peerConnection.setLocalDescription(answer); showVideoArea(true); socket.emit('webrtc-answer', { to: otherUserId, from: userId, swapId, sdp: answer }); acceptCallBtn.style.display = 'none'; hasIncomingOffer = null; } catch {}
    }
    function endCall() {
      if (peerConnection) { peerConnection.getSenders().forEach(s => { try { s.track?.stop(); } catch {} }); peerConnection.close(); peerConnection = null; }
      if (localStream) { localStream.getTracks().forEach(t => t.stop()); localStream = null; }
      showVideoArea(false);
    }
    startCallBtn.addEventListener('click', startCall);
    acceptCallBtn.addEventListener('click', acceptCall);
    endCallBtn.addEventListener('click', endCall);
    socket.on('webrtc-offer', async (payload) => { if (payload.to !== userId || payload.swapId !== swapId) return; hasIncomingOffer = payload; acceptCallBtn.style.display = ''; });
    socket.on('webrtc-answer', async (payload) => { if (payload.to !== userId || payload.swapId !== swapId) return; if (peerConnection) await peerConnection.setRemoteDescription(new RTCSessionDescription(payload.sdp)); });
    socket.on('webrtc-ice', async (payload) => { if (payload.to !== userId || payload.swapId !== swapId) return; try { if (peerConnection && payload.candidate) await peerConnection.addIceCandidate(new RTCIceCandidate(payload.candidate)); } catch {} });

    // Global toast
    window.showToast = function(msg, type) {
      const container = document.getElementById('toastContainer');
      if (!container) return;
      const v = ({error:'danger', warning:'warning', success:'success', info:'info'})[type] || 'success';
      const el = document.createElement('div');
      el.className = 'toast text-bg-' + v;
      el.innerHTML = `<div class="toast-body">${msg}</div>`;
      container.appendChild(el);
      new bootstrap.Toast(el, { delay: 4000 }).show();
      el.addEventListener('hidden.bs.toast', () => el.remove());
    };
  </script>
</body>
</html>
