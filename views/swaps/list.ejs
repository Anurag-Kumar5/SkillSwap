<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
  <title>My Swaps — SkillSwap</title>
  <meta name="description" content="Manage your skill exchange requests and track your swap history on SkillSwap.">
</head>
<body>
  <%- include('../partials/header') %>

  <main>
    <div class="page-header">
      <div class="page-header-inner">
        <div class="breadcrumb">
          <span class="breadcrumb-item"><a href="/">Home</a></span>
          <span class="breadcrumb-item active">My Swaps</span>
        </div>
        <h1 class="page-title">My Swaps</h1>
        <p class="page-subtitle">Manage your skill exchange requests and conversations.</p>
      </div>
    </div>

    <div class="container fade-in" style="max-width: var(--container-max); padding: var(--space-8) var(--space-6);">
      <!-- Tab Filters -->
      <ul class="nav nav-pills mb-6" id="swapTabs" style="gap: var(--space-1); margin-bottom: var(--space-6);">
        <li class="nav-item">
          <button class="nav-link active" data-filter="all">All</button>
        </li>
        <li class="nav-item">
          <button class="nav-link" data-filter="pending">
            <i class="bi bi-clock me-1"></i>Pending
          </button>
        </li>
        <li class="nav-item">
          <button class="nav-link" data-filter="accepted">
            <i class="bi bi-check-circle me-1"></i>Active
          </button>
        </li>
        <li class="nav-item">
          <button class="nav-link" data-filter="completed">
            <i class="bi bi-trophy me-1"></i>Completed
          </button>
        </li>
      </ul>

      <% if (swaps.length > 0) { %>
        <div class="row g-4" id="swapsGrid">
          <% swaps.forEach(swap => { %>
            <div class="col-md-6 col-xl-4 swap-item" data-status="<%= swap.status %>">
              <div class="swap-card h-100" style="display: flex; flex-direction: column; gap: var(--space-4);">
                <!-- Header -->
                <div style="display: flex; align-items: flex-start; justify-content: space-between;">
                  <div style="display: flex; align-items: center; gap: var(--space-3);">
                    <img src="<%= swap.requester.avatar || 'https://ui-avatars.com/api/?name=' + encodeURIComponent(swap.requester.name) + '&background=2563EB&color=fff&size=64' %>"
                         class="avatar avatar-md"
                         alt="<%= swap.requester.name %>"
                         onerror="this.src='https://ui-avatars.com/api/?name=<%= encodeURIComponent(swap.requester.name) %>&background=2563EB&color=fff&size=64'">
                    <div>
                      <div style="font-size: var(--text-sm); font-weight: var(--weight-semibold); color: var(--color-text);">
                        <%= swap.requester.name %>
                      </div>
                      <div style="font-size: var(--text-xs); color: var(--color-text-muted);">
                        <i class="bi bi-clock me-1"></i><%= new Date(swap.createdAt).toLocaleDateString() %>
                      </div>
                    </div>
                  </div>
                  <span class="status-badge status-<%= swap.status %>">
                    <% if (swap.status === 'pending')   { %><i class="bi bi-clock me-1"></i><% } %>
                    <% if (swap.status === 'accepted')  { %><i class="bi bi-check me-1"></i><% } %>
                    <% if (swap.status === 'completed') { %><i class="bi bi-trophy me-1"></i><% } %>
                    <% if (swap.status === 'rejected')  { %><i class="bi bi-x me-1"></i><% } %>
                    <%= swap.status %>
                  </span>
                </div>

                <!-- Exchange visual -->
                <div class="swap-exchange">
                  <div style="flex: 1; min-width: 0;">
                    <div style="font-size: 10px; font-weight: var(--weight-semibold); color: var(--color-text-muted); text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: var(--space-1);">
                      <% if (swap.requester._id.equals(user._id)) { %>You offer<% } else { %>They offer<% } %>
                    </div>
                    <span class="skill-chip" style="font-size: var(--text-xs);"><%= swap.skillOffered.name %></span>
                  </div>
                  <div class="swap-exchange-arrow">
                    <i class="bi bi-arrow-left-right"></i>
                  </div>
                  <div style="flex: 1; min-width: 0; text-align: right;">
                    <div style="font-size: 10px; font-weight: var(--weight-semibold); color: var(--color-text-muted); text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: var(--space-1);">
                      <% if (swap.requester._id.equals(user._id)) { %>You want<% } else { %>They want<% } %>
                    </div>
                    <span class="skill-chip skill-chip-wanted" style="font-size: var(--text-xs);"><%= swap.skillRequested.name %></span>
                  </div>
                </div>

                <!-- Actions -->
                <div style="display: flex; flex-wrap: wrap; gap: var(--space-2); margin-top: auto; padding-top: var(--space-3); border-top: 1px solid var(--color-border);">
                  <% if (swap.recipient._id.equals(user._id) && swap.status === 'pending') { %>
                    <button class="btn btn-success btn-sm accept-swap" data-swap-id="<%= swap._id %>">
                      <i class="bi bi-check-lg me-1"></i>Accept
                    </button>
                    <button class="btn btn-outline-danger btn-sm reject-swap" data-swap-id="<%= swap._id %>">
                      <i class="bi bi-x-lg me-1"></i>Decline
                    </button>
                  <% } %>
                  <% if (swap.status === 'accepted') { %>
                    <a class="btn btn-primary btn-sm" href="/swaps/<%= swap._id %>/chat">
                      <i class="bi bi-chat-text me-1"></i>Open Chat
                    </a>
                  <% } %>
                  <% if (swap.status === 'completed') { %>
                    <button class="btn btn-outline-secondary btn-sm open-review"
                            data-swap-id="<%= swap._id %>"
                            data-partner-name="<%= (swap.requester._id.equals(user._id) ? swap.recipient.name : swap.requester.name) %>">
                      <i class="bi bi-star me-1"></i>Leave Review
                    </button>
                  <% } %>
                </div>
              </div>
            </div>
          <% }); %>
        </div>
      <% } else { %>
        <div class="empty-state">
          <div class="empty-state-icon"><i class="bi bi-arrow-left-right"></i></div>
          <h3 class="empty-state-title">No swaps yet</h3>
          <p class="empty-state-description">
            You haven't made any swap requests yet. Start by browsing skills or adding your own.
          </p>
          <div class="empty-state-actions">
            <a href="/browse" class="btn btn-primary"><i class="bi bi-compass me-1"></i>Browse Skills</a>
            <a href="/skills/add" class="btn btn-outline-secondary"><i class="bi bi-plus-circle me-1"></i>Add a Skill</a>
          </div>
        </div>
      <% } %>
    </div>
  </main>

  <%- include('../partials/footer') %>

  <!-- Review Modal -->
  <div class="modal fade" id="reviewModal" tabindex="-1" aria-labelledby="reviewModalLabel">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="reviewModalLabel">Leave a Review</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <form id="reviewForm">
            <input type="hidden" id="reviewSwapId">
            <div style="margin-bottom: var(--space-4);">
              <label class="form-label">Rating</label>
              <div class="rating-input" style="justify-content: center;">
                <input type="radio" name="rating" value="5" id="star5"><label for="star5">★</label>
                <input type="radio" name="rating" value="4" id="star4"><label for="star4">★</label>
                <input type="radio" name="rating" value="3" id="star3"><label for="star3">★</label>
                <input type="radio" name="rating" value="2" id="star2"><label for="star2">★</label>
                <input type="radio" name="rating" value="1" id="star1"><label for="star1">★</label>
              </div>
            </div>
            <div>
              <label for="reviewComment" class="form-label">Your review</label>
              <textarea class="form-control" id="reviewComment" rows="3"
                        placeholder="Share your experience with this swap..."></textarea>
            </div>
          </form>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="button" class="btn btn-primary" onclick="submitReview()">Submit Review</button>
        </div>
      </div>
    </div>
  </div>

  <script>
    // ── Tab Filtering ──────────────────────────────────────
    document.querySelectorAll('#swapTabs .nav-link').forEach(btn => {
      btn.addEventListener('click', function() {
        document.querySelectorAll('#swapTabs .nav-link').forEach(b => b.classList.remove('active'));
        this.classList.add('active');
        const filter = this.dataset.filter;
        document.querySelectorAll('.swap-item').forEach(item => {
          const show = filter === 'all' || item.dataset.status === filter;
          item.style.display = show ? '' : 'none';
        });
      });
    });

    // ── Existing API logic (unchanged) ────────────────────
    document.addEventListener('click', function(e) {
      const btn = e.target.closest('.accept-swap');
      if (btn) updateSwapStatus(btn.dataset.swapId, 'accepted');
    });
    document.addEventListener('click', function(e) {
      const btn = e.target.closest('.reject-swap');
      if (btn) updateSwapStatus(btn.dataset.swapId, 'rejected');
    });
    document.addEventListener('click', function(e) {
      const btn = e.target.closest('.mark-completed');
      if (btn) markAsCompleted(btn.dataset.swapId);
    });
    document.addEventListener('click', function(e) {
      const btn = e.target.closest('.open-review');
      if (btn) {
        document.getElementById('reviewSwapId').value = btn.dataset.swapId;
        document.querySelector('#reviewModal .modal-title').textContent = 'Review for ' + btn.dataset.partnerName;
        new bootstrap.Modal('#reviewModal').show();
      }
    });

    async function markAsCompleted(swapId) {
      try {
        const response = await fetch(`/api/swaps/${swapId}/status`, {
          method: 'PATCH', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ status: 'completed' })
        });
        const result = await response.json();
        if (result.success) { showToast('Swap completed! +50 XP earned!', 'success'); setTimeout(() => location.reload(), 1500); }
        else showToast(result.message || 'Failed', 'danger');
      } catch { showToast('Failed to mark as completed', 'danger'); }
    }

    async function updateSwapStatus(swapId, status) {
      try {
        const response = await fetch(`/api/swaps/${swapId}/status`, {
          method: 'PATCH', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ status })
        });
        const result = await response.json();
        if (result.success) {
          showToast(status === 'accepted' ? 'Swap accepted! +20 XP earned!' : 'Swap declined', status === 'accepted' ? 'success' : 'info');
          setTimeout(() => location.reload(), 1500);
        } else showToast(result.message || 'Failed', 'danger');
      } catch { showToast('Failed to update swap', 'danger'); }
    }

    async function submitReview() {
      const swapId = document.getElementById('reviewSwapId').value;
      const rating = document.querySelector('input[name="rating"]:checked')?.value;
      const comment = document.getElementById('reviewComment').value;
      if (!rating) { showToast('Please select a rating', 'warning'); return; }
      try {
        const response = await fetch(`/api/swaps/${swapId}/reviews`, {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ rating: parseInt(rating), comment })
        });
        const result = await response.json();
        if (result.success) {
          showToast('Review submitted! +10 XP earned!', 'success');
          bootstrap.Modal.getInstance('#reviewModal').hide();
          setTimeout(() => location.reload(), 1500);
        } else showToast(result.message || 'Failed', 'danger');
      } catch { showToast('Failed to submit review', 'danger'); }
    }
  </script>
</body>
</html>
