<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
  <title>Add Skill — SkillSwap</title>
  <meta name="description" content="Add a new skill to your SkillSwap profile and start exchanging knowledge.">
</head>
<body>
  <%- include('../partials/header') %>

  <main>
    <div class="page-header">
      <div class="page-header-inner">
        <div class="breadcrumb">
          <span class="breadcrumb-item"><a href="/">Home</a></span>
          <span class="breadcrumb-item"><a href="/profile">Profile</a></span>
          <span class="breadcrumb-item active">Add Skill</span>
        </div>
        <h1 class="page-title">Add a New Skill</h1>
        <p class="page-subtitle">Share your expertise and help others learn something new.</p>
      </div>
    </div>

    <div class="container fade-in" style="max-width: 640px; padding: var(--space-8) var(--space-6);">
      <div class="card">
        <div class="card-header">
          <i class="bi bi-plus-circle me-2" style="color: var(--color-primary);"></i>Skill Details
        </div>
        <div class="card-body" style="padding: var(--space-6);">
          <!-- Form action preserved -->
          <form action="/skills" method="POST" style="display: flex; flex-direction: column; gap: var(--space-5);">
            <div>
              <label for="name" class="form-label">
                Skill Name <span style="color: var(--color-danger);">*</span>
              </label>
              <input type="text" class="form-control" id="name" name="name"
                     placeholder="e.g., JavaScript Programming, Guitar, Spanish" required>
            </div>

            <div class="row g-4">
              <div class="col-md-6">
                <label for="category" class="form-label">
                  Category <span style="color: var(--color-danger);">*</span>
                </label>
                <select class="form-select" id="category" name="category" required>
                  <option value="">Choose a category</option>
                  <option value="Tech">💻 Technology</option>
                  <option value="Music">🎵 Music</option>
                  <option value="Art">🎨 Art & Design</option>
                  <option value="Language">🗣️ Languages</option>
                  <option value="Cooking">🍳 Cooking</option>
                  <option value="Other">✨ Other</option>
                </select>
              </div>
              <div class="col-md-6">
                <label for="proficiency" class="form-label">Proficiency Level</label>
                <select class="form-select" id="proficiency" name="proficiency">
                  <option value="Beginner">🌱 Beginner</option>
                  <option value="Intermediate">🌿 Intermediate</option>
                  <option value="Advanced">🌳 Advanced</option>
                  <option value="Expert">🏆 Expert</option>
                </select>
              </div>
            </div>

            <div>
              <label for="description" class="form-label">
                Description <span style="color: var(--color-text-muted); font-weight: 400;">(optional)</span>
              </label>
              <textarea class="form-control" id="description" name="description" rows="4"
                        placeholder="What can you teach? What will students learn? What's your experience with this skill?"></textarea>
              <div class="form-text">A clear description helps others decide if you're the right match.</div>
            </div>

            <div style="display: flex; gap: var(--space-3); padding-top: var(--space-2); border-top: 1px solid var(--color-border);">
              <button type="submit" class="btn btn-primary">
                <i class="bi bi-plus-circle me-1"></i>Add Skill
              </button>
              <a class="btn btn-outline-secondary" href="/profile">
                Cancel
              </a>
            </div>
          </form>
        </div>
      </div>
    </div>
  </main>

  <%- include('../partials/footer') %>
</body>
</html>