<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= isAdminLogin ? 'Admin Sign In' : 'Sign In' %> — SkillSwap</title>
  <meta name="description" content="Sign in to your SkillSwap account to continue your skill exchange journey.">
  <!-- Bootstrap 5 CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/design-system.css">
  <link rel="stylesheet" href="/css/components.css">
  <link rel="stylesheet" href="/css/layout.css">
  <link rel="stylesheet" href="/css/responsive.css">
  <script>
    (function(){
      const t = localStorage.getItem('theme') || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      document.documentElement.setAttribute('data-theme', t);
    })();
  </script>
</head>
<body style="background: var(--color-bg);">
  <div class="auth-layout">
    <!-- Left Panel -->
    <div class="auth-panel-left <%= isAdminLogin ? 'admin-panel-left' : '' %>">
      <a href="/" class="auth-logo text-decoration-none">SkillSwap</a>
      <% if (isAdminLogin) { %>
        <h2 class="auth-headline">Admin Dashboard</h2>
        <p class="auth-description">Manage your SkillSwap community, users, and platform settings.</p>
        <ul class="auth-feature-list">
          <li class="auth-feature-item">
            <span class="auth-feature-icon"><i class="bi bi-people"></i></span>
            User management & moderation
          </li>
          <li class="auth-feature-item">
            <span class="auth-feature-icon"><i class="bi bi-graph-up"></i></span>
            Platform analytics & insights
          </li>
          <li class="auth-feature-item">
            <span class="auth-feature-icon"><i class="bi bi-shield-check"></i></span>
            Secure admin-only access
          </li>
        </ul>
      <% } else { %>
        <h2 class="auth-headline">Welcome back to SkillSwap</h2>
        <p class="auth-description">Sign in to continue learning and teaching the skills that matter to you.</p>
        <ul class="auth-feature-list">
          <li class="auth-feature-item">
            <span class="auth-feature-icon"><i class="bi bi-arrow-left-right"></i></span>
            Exchange skills with people worldwide
          </li>
          <li class="auth-feature-item">
            <span class="auth-feature-icon"><i class="bi bi-camera-video"></i></span>
            Built-in video & chat sessions
          </li>
          <li class="auth-feature-item">
            <span class="auth-feature-icon"><i class="bi bi-star"></i></span>
            Build your reputation & earn badges
          </li>
        </ul>
      <% } %>
    </div>

    <!-- Right Panel (Form) -->
    <div class="auth-panel-right">
      <div class="auth-form-container fade-in">
        <!-- Back link -->
        <a href="/" class="d-inline-flex align-items-center gap-2 text-decoration-none mb-6" style="color: var(--color-text-secondary); font-size: var(--text-sm); margin-bottom: var(--space-8); display: inline-flex !important;">
          <i class="bi bi-arrow-left"></i> Back to home
        </a>

        <div style="margin-bottom: var(--space-8);">
          <h1 style="font-size: var(--text-2xl); font-weight: var(--weight-bold); color: var(--color-text); margin-bottom: var(--space-2);">
            <%= isAdminLogin ? 'Admin Sign In' : 'Sign In' %>
          </h1>
          <p style="font-size: var(--text-sm); color: var(--color-text-secondary); margin: 0;">
            <% if (!isAdminLogin) { %>
              Don't have an account? <a href="/signup" style="color: var(--color-primary); font-weight: var(--weight-medium);">Create one free</a>
            <% } else { %>
              <a href="/login" style="color: var(--color-primary); font-weight: var(--weight-medium);">Switch to user login</a>
            <% } %>
          </p>
        </div>

        <!-- Error Message -->
        <% if (messages.error) { %>
          <div class="alert alert-danger d-flex align-items-center gap-2 mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill flex-shrink-0"></i>
            <span><%= messages.error %></span>
          </div>
        <% } %>

        <!-- Login Form (action and method unchanged) -->
        <form action="/login" method="POST" style="display: flex; flex-direction: column; gap: var(--space-4);">
          <div>
            <label for="email" class="form-label">
              <%= isAdminLogin ? 'Admin Email' : 'Email address' %>
            </label>
            <input type="email" class="form-control" id="email" name="email"
                   value="<%= oldInput.email %>"
                   placeholder="you@example.com" required autocomplete="email">
          </div>

          <div>
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--space-2);">
              <label for="password" class="form-label" style="margin-bottom: 0;">Password</label>
            </div>
            <input type="password" class="form-control" id="password" name="password"
                   placeholder="Enter your password" required autocomplete="current-password">
          </div>

          <input type="hidden" name="isAdmin" value="<%= isAdminLogin %>">

          <button type="submit" class="btn btn-primary w-100" style="margin-top: var(--space-2);">
            <i class="bi bi-box-arrow-in-right me-1"></i>
            <%= isAdminLogin ? 'Sign In as Admin' : 'Sign In' %>
          </button>
        </form>

        <% if (!isAdminLogin) { %>
          <!-- Divider -->
          <div class="divider-text" style="margin: var(--space-6) 0;">
            <span>or continue with</span>
          </div>

          <!-- Google OAuth (href unchanged) -->
          <a href="/auth/google" class="btn w-100" style="background: var(--color-surface); border: 1px solid var(--color-border); color: var(--color-text); font-size: var(--text-sm); font-weight: var(--weight-medium); padding: 0.625rem 1rem; justify-content: center; display: flex; align-items: center; gap: 0.5rem; border-radius: var(--radius-base); transition: all var(--transition-base);"
             onmouseover="this.style.borderColor='var(--color-border-strong)'; this.style.boxShadow='var(--shadow-sm)';"
             onmouseout="this.style.borderColor='var(--color-border)'; this.style.boxShadow='none';">
            <!-- Google SVG -->
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M17.64 9.205c0-.639-.057-1.252-.164-1.841H9v3.481h4.844a4.14 4.14 0 01-1.796 2.716v2.259h2.908c1.702-1.567 2.684-3.875 2.684-6.615z" fill="#4285F4"/>
              <path d="M9 18c2.43 0 4.467-.806 5.956-2.18l-2.908-2.259c-.806.54-1.837.86-3.048.86-2.344 0-4.328-1.584-5.036-3.711H.957v2.332A8.997 8.997 0 009 18z" fill="#34A853"/>
              <path d="M3.964 10.71A5.41 5.41 0 013.682 9c0-.593.102-1.17.282-1.71V4.958H.957A8.996 8.996 0 000 9c0 1.452.348 2.827.957 4.042l3.007-2.332z" fill="#FBBC05"/>
              <path d="M9 3.58c1.321 0 2.508.454 3.44 1.345l2.582-2.58C13.463.891 11.426 0 9 0A8.997 8.997 0 00.957 4.958L3.964 7.29C4.672 5.163 6.656 3.58 9 3.58z" fill="#EA4335"/>
            </svg>
            Continue with Google
          </a>

          <p style="text-align: center; margin-top: var(--space-5); font-size: var(--text-xs); color: var(--color-text-muted);">
            <a href="/login?admin=true" style="color: var(--color-text-muted);">Admin login</a>
          </p>
        <% } %>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <style>
    .admin-panel-left { background-color: #0F172A; }
    @media (max-width: 768px) {
      .auth-layout { flex-direction: column; }
      .auth-panel-right { padding: var(--space-8) var(--space-5); min-height: 100vh; }
    }
  </style>
</body>
</html>