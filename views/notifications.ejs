<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
  <title>Notifications — SkillSwap</title>
</head>
<body>
  <%- include('partials/header') %>

  <main>
    <div class="page-header">
      <div class="page-header-inner" style="display: flex; align-items: flex-start; justify-content: space-between; flex-wrap: wrap; gap: var(--space-4);">
        <div>
          <div class="breadcrumb">
            <span class="breadcrumb-item"><a href="/">Home</a></span>
            <span class="breadcrumb-item active">Notifications</span>
          </div>
          <h1 class="page-title">Notifications</h1>
          <p class="page-subtitle">Stay up to date with your swap activity.</p>
        </div>
        <button onclick="markAllRead()" class="btn btn-outline-secondary btn-sm" style="align-self: flex-end; margin-bottom: var(--space-2);">
          <i class="bi bi-check2-all me-1"></i>Mark all as read
        </button>
      </div>
    </div>

    <div class="container fade-in" style="max-width: 700px; padding: var(--space-8) var(--space-6);">
      <% if (notifications.length === 0) { %>
        <div class="empty-state">
          <div class="empty-state-icon"><i class="bi bi-bell"></i></div>
          <h3 class="empty-state-title">No notifications</h3>
          <p class="empty-state-description">You're all caught up! Notifications about swaps, messages, and reviews will appear here.</p>
          <div class="empty-state-actions">
            <a href="/browse" class="btn btn-primary"><i class="bi bi-compass me-1"></i>Discover Skills</a>
          </div>
        </div>
      <% } else { %>
        <div class="card" style="overflow: hidden;">
          <% notifications.forEach((n, idx) => { %>
            <div class="notif-item <%= n.read ? '' : 'unread' %>" id="notif-<%= n._id %>"
                 <% if (n.link) { %>onclick="if(!event.target.closest('button')) window.location.href='<%= n.link %>'" style="cursor: pointer;"<% } %>>
              <!-- Icon -->
              <div class="notif-icon" style="background: <%= n.type === 'swap_request' ? 'var(--color-primary-light)' : n.type === 'swap_accepted' ? 'var(--color-success-light)' : n.type === 'new_message' ? 'var(--color-info-light)' : 'var(--color-bg-muted)' %>; color: <%= n.type === 'swap_request' ? 'var(--color-primary)' : n.type === 'swap_accepted' ? 'var(--color-success)' : n.type === 'new_message' ? 'var(--color-info)' : 'var(--color-text-secondary)' %>;">
                <% if (n.type === 'swap_request') { %><i class="bi bi-arrow-left-right"></i>
                <% } else if (n.type === 'swap_accepted') { %><i class="bi bi-check-circle"></i>
                <% } else if (n.type === 'swap_rejected') { %><i class="bi bi-x-circle"></i>
                <% } else if (n.type === 'new_message') { %><i class="bi bi-chat-text"></i>
                <% } else if (n.type === 'review_received') { %><i class="bi bi-star"></i>
                <% } else { %><i class="bi bi-bell"></i>
                <% } %>
              </div>
              <!-- Content -->
              <div class="notif-content">
                <% if (!n.read) { %>
                  <div style="font-size: 10px; font-weight: var(--weight-semibold); color: var(--color-primary); text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 4px;"><%= n.type.replace(/_/g,' ') %></div>
                <% } else { %>
                  <div style="font-size: 10px; font-weight: var(--weight-medium); color: var(--color-text-muted); text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 4px;"><%= n.type.replace(/_/g,' ') %></div>
                <% } %>
                <p class="notif-message"><%= n.message %></p>
                <div style="display: flex; align-items: center; gap: var(--space-3); margin-top: var(--space-1);">
                  <p class="notif-time"><i class="bi bi-clock me-1"></i><%= new Date(n.createdAt).toLocaleString() %></p>
                  <% if (n.link) { %>
                    <a href="<%= n.link %>" style="font-size: var(--text-xs); font-weight: var(--weight-medium); color: var(--color-primary);">View →</a>
                  <% } %>
                </div>
              </div>
              <!-- Mark read button -->
              <% if (!n.read) { %>
                <button class="btn btn-ghost btn-icon-sm flex-shrink-0" onclick="markRead('<%= n._id %>', this)" title="Mark as read" aria-label="Mark as read">
                  <i class="bi bi-check2" style="font-size: 0.875rem;"></i>
                </button>
              <% } %>
            </div>
          <% }); %>
        </div>
      <% } %>
    </div>
  </main>

  <%- include('partials/footer') %>

  <script>
    function markRead(id, btn) {
      fetch(`/notifications/${id}/read`, { method: 'POST' }).then(() => {
        const item = btn.closest('.notif-item');
        if (item) {
          item.classList.remove('unread');
          btn.remove();
        }
      });
    }
    function markAllRead() {
      fetch('/notifications/read-all', { method: 'POST' }).then(() => location.reload());
    }
  </script>
</body>
</html>
