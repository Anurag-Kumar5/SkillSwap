<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
  <title>User Management — SkillSwap Admin</title>
</head>
<body>
  <%- include('../partials/header') %>

  <main>
    <div style="display: flex; min-height: calc(100vh - var(--nav-height));">
      <!-- Admin Sidebar -->
      <div class="admin-sidebar">
        <div style="padding: var(--space-4) var(--space-6) var(--space-2);">
          <div style="font-size: var(--text-xs); font-weight: var(--weight-semibold); color: var(--color-text-muted); text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: var(--space-2);">Admin</div>
        </div>
        <a href="/admin/dashboard" class="admin-sidebar-link">
          <i class="bi bi-speedometer2"></i> Dashboard
        </a>
        <a href="/admin/users" class="admin-sidebar-link active">
          <i class="bi bi-people"></i> Users
        </a>
        <div style="margin-top: auto; padding: var(--space-4) 0;">
          <a href="/logout" class="admin-sidebar-link" style="color: var(--color-danger);">
            <i class="bi bi-box-arrow-right"></i> Sign Out
          </a>
        </div>
      </div>

      <!-- Admin Content -->
      <div class="admin-content">
        <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: var(--space-6);">
          <div>
            <h1 style="font-size: var(--text-2xl); font-weight: var(--weight-bold); color: var(--color-text); margin-bottom: var(--space-1);">Users</h1>
            <p style="font-size: var(--text-sm); color: var(--color-text-secondary); margin: 0;"><%= users.length %> total members in your community.</p>
          </div>
          <a href="/admin/dashboard" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i>Dashboard</a>
        </div>

        <div class="card fade-in">
          <div class="card-header" style="display: flex; align-items: center; justify-content: space-between;">
            <span style="font-weight: var(--weight-semibold);"><i class="bi bi-table me-2"></i>User Directory</span>
            <span class="badge bg-secondary"><%= users.length %> users</span>
          </div>
          <% if (users.length > 0) { %>
            <div style="overflow-x: auto;">
              <table class="table">
                <thead>
                  <tr>
                    <th>User</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th>Joined</th>
                    <th width="100">Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <% users.forEach((user, idx) => { %>
                    <tr class="fade-in" style="animation-delay: <%= idx * 0.03 %>s">
                      <td>
                        <div style="display: flex; align-items: center; gap: var(--space-3);">
                          <img src="<%= user.avatar || 'https://ui-avatars.com/api/?name=' + encodeURIComponent(user.name || user.username || 'U') + '&background=2563EB&color=fff&size=32' %>"
                               class="avatar avatar-sm"
                               onerror="this.src='https://ui-avatars.com/api/?name=<%= encodeURIComponent(user.name || 'U') %>&background=2563EB&color=fff&size=32'">
                          <div>
                            <div style="font-size: var(--text-sm); font-weight: var(--weight-medium); color: var(--color-text);"><%= user.name || user.username %></div>
                            <div style="font-size: var(--text-xs); color: var(--color-text-muted);">ID: ...<%=  user._id.toString().slice(-8) %></div>
                          </div>
                        </div>
                      </td>
                      <td style="font-size: var(--text-sm); color: var(--color-text-secondary);"><%= user.email %></td>
                      <td>
                        <span class="badge <%= user.role === 'admin' ? 'bg-danger' : 'bg-success' %>">
                          <%= user.role || 'user' %>
                        </span>
                      </td>
                      <td>
                        <span style="font-size: var(--text-xs); color: var(--color-text-muted);"><%= new Date(user.createdAt).toLocaleDateString() %></span>
                      </td>
                      <td>
                        <!-- Form action preserved exactly -->
                        <form action="/admin/users/<%= user._id %>/delete" method="POST" style="display: inline;">
                          <button type="submit" class="btn btn-outline-danger btn-sm"
                                  onclick="return confirm('Delete this user? This cannot be undone.')">
                            <i class="bi bi-trash3"></i>
                          </button>
                        </form>
                      </td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
          <% } else { %>
            <div class="empty-state">
              <div class="empty-state-icon"><i class="bi bi-people"></i></div>
              <h3 class="empty-state-title">No Users Yet</h3>
              <p class="empty-state-description">Your SkillSwap community is just getting started!</p>
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </main>

  <%- include('../partials/footer') %>
</body>
</html>