<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
  <title>Admin Dashboard — SkillSwap</title>
</head>
<body>
  <%- include('../partials/header') %>

  <main>
    <div style="display: flex; min-height: calc(100vh - var(--nav-height));">
      <!-- Admin Sidebar -->
      <div class="admin-sidebar">
        <div style="padding: var(--space-4) var(--space-6) var(--space-2);">
          <div style="font-size: var(--text-xs); font-weight: var(--weight-semibold); color: var(--color-text-muted); text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: var(--space-2);">Admin</div>
        </div>
        <a href="/admin/dashboard" class="admin-sidebar-link active">
          <i class="bi bi-speedometer2"></i> Dashboard
        </a>
        <a href="/admin/users" class="admin-sidebar-link">
          <i class="bi bi-people"></i> Users
        </a>
        <div style="padding: var(--space-4) var(--space-6) var(--space-2); margin-top: auto;">
          <a href="/logout" class="admin-sidebar-link" style="color: var(--color-danger);">
            <i class="bi bi-box-arrow-right"></i> Sign Out
          </a>
        </div>
      </div>

      <!-- Admin Content -->
      <div class="admin-content">
        <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: var(--space-8);">
          <div>
            <h1 style="font-size: var(--text-2xl); font-weight: var(--weight-bold); color: var(--color-text); margin-bottom: var(--space-1);">Overview</h1>
            <p style="font-size: var(--text-sm); color: var(--color-text-secondary); margin: 0;">Your SkillSwap community at a glance.</p>
          </div>
        </div>

        <!-- Stats Cards -->
        <div class="row g-4 mb-8" style="margin-bottom: var(--space-8);">
          <div class="col-sm-4">
            <div class="admin-stat-card">
              <div class="admin-stat-icon" style="background: var(--color-primary-light); color: var(--color-primary);">
                <i class="bi bi-people"></i>
              </div>
              <div>
                <span class="admin-stat-value"><%= users.length %></span>
                <span class="admin-stat-label">Total Users</span>
              </div>
            </div>
          </div>
          <div class="col-sm-4">
            <div class="admin-stat-card">
              <div class="admin-stat-icon" style="background: var(--color-success-light); color: var(--color-success);">
                <i class="bi bi-person-plus"></i>
              </div>
              <div>
                <span class="admin-stat-value"><%= users.filter(u => new Date(u.createdAt) > new Date(Date.now() - 7*24*60*60*1000)).length %></span>
                <span class="admin-stat-label">New This Week</span>
              </div>
            </div>
          </div>
          <div class="col-sm-4">
            <div class="admin-stat-card">
              <div class="admin-stat-icon" style="background: var(--color-warning-light); color: var(--color-warning);">
                <i class="bi bi-graph-up"></i>
              </div>
              <div>
                <span class="admin-stat-value"><%= Math.round((users.filter(u => new Date(u.createdAt) > new Date(Date.now() - 7*24*60*60*1000)).length / Math.max(users.length, 1)) * 100) %>%</span>
                <span class="admin-stat-label">Weekly Growth</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Recent Users Table -->
        <div class="card">
          <div class="card-header" style="display: flex; align-items: center; justify-content: space-between;">
            <span style="font-weight: var(--weight-semibold);"><i class="bi bi-table me-2"></i>Recent Users</span>
            <div style="display: flex; align-items: center; gap: var(--space-3);">
              <span class="badge bg-secondary"><%= users.length %> total</span>
              <a href="/admin/users" class="btn btn-primary btn-sm"><i class="bi bi-people me-1"></i>View All</a>
            </div>
          </div>
          <% if (users.length > 0) { %>
            <div style="overflow-x: auto;">
              <table class="table">
                <thead>
                  <tr>
                    <th>User</th>
                    <th>Email</th>
                    <th>Joined</th>
                    <th>Status</th>
                  </tr>
                </thead>
                <tbody>
                  <% users.slice(0, 10).forEach((user, idx) => { %>
                    <tr class="fade-in" style="animation-delay: <%= idx * 0.04 %>s">
                      <td>
                        <div style="display: flex; align-items: center; gap: var(--space-3);">
                          <img src="<%= user.avatar || 'https://ui-avatars.com/api/?name=' + encodeURIComponent(user.name || user.username || 'U') + '&background=2563EB&color=fff&size=32' %>"
                               class="avatar avatar-sm"
                               onerror="this.src='https://ui-avatars.com/api/?name=<%= encodeURIComponent(user.name || 'U') %>&background=2563EB&color=fff&size=32'">
                          <span style="font-size: var(--text-sm); font-weight: var(--weight-medium); color: var(--color-text);"><%= user.name || user.username %></span>
                        </div>
                      </td>
                      <td style="color: var(--color-text-secondary);"><%= user.email %></td>
                      <td>
                        <span style="font-size: var(--text-xs); color: var(--color-text-muted);"><%= new Date(user.createdAt).toLocaleDateString() %></span>
                      </td>
                      <td><span class="badge bg-success">Active</span></td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
            <div class="card-footer" style="display: flex; align-items: center; justify-content: space-between;">
              <span style="font-size: var(--text-sm); color: var(--color-text-secondary);">Showing <%= Math.min(users.length, 10) %> of <%= users.length %> users</span>
              <a href="/admin/users" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-right me-1"></i>View All Users</a>
            </div>
          <% } else { %>
            <div class="empty-state">
              <div class="empty-state-icon"><i class="bi bi-people"></i></div>
              <h3 class="empty-state-title">No users yet</h3>
              <p class="empty-state-description">Your SkillSwap community is just getting started!</p>
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </main>

  <%- include('../partials/footer') %>
</body>
</html>